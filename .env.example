# --- PayPal (Sandbox) -----------------------------------------------------------
# developer.paypal.com -> Apps & Credentials -> Sandbox -> create app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID of the webhook you register for /api/webhooks/paypal (see README)
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Where PayPal sends the buyer back after approving. Use your public URL when deployed.
PUBLIC_BASE_URL=http://localhost:8000

# --- Channel3 (product catalog + live prices); leave empty for the built-in demo catalog ---
CHANNEL3_API_KEY=
CATALOG_QUERY=wireless headphones
CATALOG_SIZE=8

# --- LLM (optional). Without it the promise parser and customer messages use rule-based fallbacks ---
# Free key from Google AI Studio (aistudio.google.com -> Get API key)
GEMINI_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite

# --- App ---------------------------------------------------------------------------
# REQUIRED on any public deployment: protects the merchant page and API
ADMIN_TOKEN=
# Run the watcher automatically every N seconds (0 = only when you click "Run watcher now")
WATCH_INTERVAL_SECONDS=0
DEFAULT_DAILY_BUDGET=100
PRICEBACK_DB=priceback.db
# Load app/seed_catalog.json (100 products + the price promise) when the database is empty.
# On for Render (its free disk resets); locally your own priceback.db already has the catalog.
SEED_CATALOG=false

# --- Shopper accounts + notifications ------------------------------------------------
# Shoppers sign in with a one-time code sent to their own email; order confirmations and
# price-drop refund emails go to the same address.
# Pick ONE way to send email (if both are set, SMTP is used):
#  a) SMTP with Python's smtplib, free. Gmail: turn on 2-Step Verification, create an App Password at
#     myaccount.google.com/apppasswords, put it below (~500 emails/day). Works locally and on hosts that
#     allow SMTP, but NOT on Render's free plan, which blocks outbound SMTP ports 25/465/587.
SMTP_HOST=smtp.gmail.com
# 587 = STARTTLS, 465 = SSL
SMTP_PORT=587
# Use a separate project Gmail, not your personal one: testers see this address as the sender
SMTP_USER=your-project@gmail.com
# The 16-letter App Password (not your Gmail password); spaces are fine
SMTP_PASSWORD=
#  b) Brevo's HTTPS API, free (300 emails/day), and it works on Render's free plan, so use this on Render.
#     brevo.com -> Settings -> Senders -> add + verify the MAIL_FROM address;
#     then SMTP & API -> API Keys -> Generate a new API key (starts with "xkeysib-").
BREVO_API_KEY=xkeysib-...
# The From address: must be a sender verified in Brevo (defaults to SMTP_USER when using SMTP)
MAIL_FROM=your-project@gmail.com
MAIL_FROM_NAME=PriceBack
# Optional: every shopper event (order confirmed, refund sent, refund blocked) is also POSTed as JSON
# to this Zapier "Catch Hook" URL (needs Zapier's Webhooks app: paid plan or the 14-day trial).
ZAPIER_HOOK_URL=
# The PayPal SANDBOX buyer login shown to testers at checkout (fake money only, never a real account).
# developer.paypal.com -> Testing Tools -> Sandbox Accounts -> the PERSONAL (buyer) account -> View/Edit.
# Never put your real PayPal login or the sandbox BUSINESS account here: this is shown publicly.
DEMO_BUYER_EMAIL=sb-xxxxx@personal.example.com
DEMO_BUYER_PASSWORD=
# Let signed-in shoppers simulate a price drop on their own order from /account (demo)
DEMO_SELF_SERVE=true
