# --- PayPal (Sandbox) -----------------------------------------------------------
# developer.paypal.com -> Apps & Credentials -> Sandbox -> create app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID of the webhook you register for /api/webhooks/paypal (see README)
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Where PayPal sends the buyer back after approving. Use your public URL when deployed.
PUBLIC_BASE_URL=http://localhost:8000

# --- Channel3 (product catalog + live prices); leave empty for the built-in demo catalog ---
CHANNEL3_API_KEY=
CATALOG_QUERY=wireless headphones
CATALOG_SIZE=8

# --- LLM (optional). Without it the promise parser and customer messages use rule-based fallbacks ---
# Free key from Google AI Studio (aistudio.google.com -> Get API key)
GEMINI_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite

# --- App ---------------------------------------------------------------------------
# REQUIRED on any public deployment: protects the merchant page and API
ADMIN_TOKEN=
# Run the watcher automatically every N seconds (0 = only when you click "Run watcher now")
WATCH_INTERVAL_SECONDS=0
DEFAULT_DAILY_BUDGET=100
PRICEBACK_DB=priceback.db
